# Copy this file to .env.local and fill in your own values.
# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: only needed for the "Delete my account" button. Keep this secret, never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: your live website address (used for share previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Reviewer maker with Ashna AI. Server-only: never put NEXT_PUBLIC_ in front of these names.
ASHNA_API_KEY=
# Optional (defaults shown)
ASHNA_MODEL=claude-sonnet-5
ASHNA_BASE_URL=https://api.ashna.ai/v1/api
